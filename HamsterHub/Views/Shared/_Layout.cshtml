@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var nextCulture = currentCulture == "ru" ? "en" : "ru";
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@L["MetaDescription"]" />
    <title>@ViewData["Title"] · HamsterHub</title>
    <script>
        (() => {
            const savedTheme = localStorage.getItem("hamsterhub-theme");
            const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            document.documentElement.dataset.theme = savedTheme || preferredTheme;
        })();
    </script>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HamsterHub.styles.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <header class="site-header">
        <nav class="site-nav" aria-label="Main navigation">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">H</span>
                <span>Hamster<span>Hub</span></span>
            </a>
            <div class="nav-actions">
                <div class="preference-actions">
                    <form asp-controller="Home" asp-action="SetLanguage" method="post" class="preference-form">
                        <input type="hidden" name="culture" value="@nextCulture" />
                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                        <button type="submit" class="preference-button language-button" title="@L["SwitchLanguage"]"
                                aria-label="@L["SwitchLanguage"]">@nextCulture.ToUpperInvariant()</button>
                    </form>
                    <button type="button" class="preference-button theme-button" data-theme-toggle
                            aria-label="@L["ToggleTheme"]" title="@L["ToggleTheme"]">
                        <span class="theme-sun" aria-hidden="true">☀</span>
                        <span class="theme-moon" aria-hidden="true">☾</span>
                    </button>
                </div>
                <partial name="_LoginPartial" />
            </div>
        </nav>
    </header>

    @if (System.IO.File.Exists(System.IO.Path.Combine(HostEnvironment.ContentRootPath, "Downloads", "HamsterHub.apk")))
    {
        <aside class="app-download" aria-label="@L["AndroidAppTitle"]">
            <div>
                <strong>@L["AndroidAppTitle"]</strong>
                <p id="app-download-help">@L["AndroidAppHelp"]</p>
            </div>
            <a class="nav-button nav-button-primary" asp-controller="AppDownload" asp-action="Android"
               download="HamsterHub.apk" aria-describedby="app-download-help">@L["DownloadAndroidApp"]</a>
        </aside>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <a class="brand footer-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark" aria-hidden="true">H</span>
            <span>Hamster<span>Hub</span></span>
        </a>
        <p>@L["FooterText"]</p>
        <a asp-controller="Home" asp-action="Privacy">@L["Privacy"]</a>
    </footer>

    <div class="photo-viewer" data-photo-viewer hidden role="dialog" aria-modal="true"
         aria-label="@L["PhotoViewer"]">
        <button type="button" class="photo-viewer-close" data-photo-viewer-close
                aria-label="@L["Close"]">×</button>
        <button type="button" class="photo-viewer-nav photo-viewer-previous"
                data-photo-viewer-previous aria-label="@L["PreviousPhoto"]">‹</button>
        <figure>
            <img data-photo-viewer-image src="" alt="" />
            <figcaption data-photo-viewer-caption></figcaption>
        </figure>
        <button type="button" class="photo-viewer-nav photo-viewer-next"
                data-photo-viewer-next aria-label="@L["NextPhoto"]">›</button>
        <span class="photo-viewer-count" data-photo-viewer-count aria-live="polite"></span>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

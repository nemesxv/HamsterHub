@foreach (var task in Model.CareTasks)
{
    <div class="modal fade" id="edit-task-@task.Id" tabindex="-1"
         aria-labelledby="edit-task-label-@task.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content account-modal dashboard-modal">
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="@L["Close"]">×</button>
                <h2 id="edit-task-label-@task.Id">@L["EditCareTask"]</h2>
                <form asp-action="UpdateCareTask" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="UpdateCareTask.Id" value="@task.Id" />
                    <label for="task-name-@task.Id">@L["TaskName"]</label>
                    <input id="task-name-@task.Id" name="UpdateCareTask.Name" value="@task.CategoryName" required maxlength="100" />
                    <label for="task-pet-@task.Id">@L["TaskPet"]</label>
                    <select id="task-pet-@task.Id" name="UpdateCareTask.PetId">
                        <option value="" selected="@(task.PetId is null)">@L["NoPet"]</option>
                        @foreach (var pet in Model.Pets)
                        {
                            <option value="@pet.Id" selected="@(pet.Id == task.PetId)">@pet.Name</option>
                        }
                    </select>
                    <label for="task-member-@task.Id">@L["AssignedMember"]</label>
                    <select id="task-member-@task.Id" name="UpdateCareTask.AssignedMemberId">
                        @foreach (var member in Model.Members)
                        {
                            <option value="@member.Id" selected="@(member.Id == task.AssignedMemberId)">
                                @member.DisplayName · @L[$"Role_{member.Role}"]
                            </option>
                        }
                    </select>
                    <label for="task-category-@task.Id">@L["TaskCategory"]</label>
                    <select id="task-category-@task.Id" name="UpdateCareTask.CategoryId">
                        <option value="" selected="@(task.CategoryId is null)">@L["NoCategory"]</option>
                        @foreach (var category in Model.CareCategories)
                        {
                            <option value="@category.Id" selected="@(category.Id == task.CategoryId)">@category.Name</option>
                        }
                    </select>
                    <label for="task-new-category-@task.Id">@L["NewCategory"]</label>
                    <input id="task-new-category-@task.Id" name="UpdateCareTask.NewCategoryName"
                           placeholder="@L["NewCategoryPlaceholder"]" maxlength="100" />
                    <div class="task-image-current">
                        <img src="@task.ImagePath" alt="@L["TaskImageAlt", task.CategoryName]" />
                        <span>@(task.HasCustomImage ? L["CustomTaskImage"] : L["DefaultTaskImage"])</span>
                    </div>
                    <label for="task-image-@task.Id">@L["ReplaceTaskImage"]</label>
                    <input id="task-image-@task.Id" name="UpdateCareTask.Image" type="file"
                           accept="image/jpeg,image/png,image/webp" />
                    @if (task.HasCustomImage)
                    {
                        <label class="task-image-remove">
                            <input type="checkbox" name="UpdateCareTask.RemoveImage" value="true" />
                            <span>@L["UseDefaultTaskImage"]</span>
                        </label>
                    }
                    <div class="form-columns">
                        <div>
                            <label for="task-frequency-@task.Id">@L["TaskFrequency"]</label>
                            <select id="task-frequency-@task.Id" name="UpdateCareTask.Frequency">
                                @foreach (var frequency in Enum.GetValues<CareTaskFrequency>())
                                {
                                    <option value="@((int)frequency)" selected="@(frequency == task.Frequency)">@L[$"Frequency_{frequency}"]</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label for="task-points-@task.Id">@L["PointValue"]</label>
                            <input id="task-points-@task.Id" name="UpdateCareTask.PointValue"
                                   type="number" min="0" max="1000" value="@task.PointValue" />
                        </div>
                    </div>
                    <partial name="_TaskReminder" model='new TaskReminderFormModel("UpdateCareTask", $"task-{task.Id}", task.Reminder)' />
                    <button type="submit" class="modal-submit">@L["SaveChanges"]</button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model ParentDashboardViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["ParentDashboardTitle"];
}

@{
    var pendingTotal = Model.PendingCare.Count + Model.PendingRewards.Count;
}

<div hidden data-photo-labels data-camera="@L["MobileTakePhoto"]" data-gallery="@L["MobilePickPhoto"]" data-remove="@L["MobileRemovePhoto"]" data-limit="@L["MobilePhotoLimit"]"></div>
<div class="dashboard-shell parent-home">
    <section class="parent-home-hero">
        <div class="parent-home-welcome">
            <span class="parent-home-eyebrow">🏡 @L["ParentSpace"]</span>
            <h1>@L["ParentWelcome", Model.ParentName]</h1>
            <p>@L["ParentHomeIntro"]</p>
            <partial name="_DashboardAppDownload" />
        </div>
        <div class="parent-household-card">
            <span class="parent-household-icon" aria-hidden="true">♥</span>
            <div>
                <small>@L["FamilyHome"]</small>
                <strong>@Model.HouseholdName</strong>
            </div>
            <span class="parent-household-status @(pendingTotal > 0 ? "needs-attention" : "all-clear")">
                @(pendingTotal > 0
                    ? L["ItemsNeedAttention", pendingTotal]
                    : L["EverythingUpToDate"])
            </span>
        </div>
    </section>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="dashboard-notice dashboard-toast" role="status"
             data-dashboard-notice>
            <span>@statusMessage</span>
            <button type="button" class="dashboard-toast-close"
                    data-dashboard-notice-close aria-label="@L["Close"]">×</button>
        </div>
    }

    <section class="parent-attention-zone @(pendingTotal == 0 ? "parent-attention-clear" : "")"
             aria-labelledby="parent-attention-title">
        <div class="parent-zone-heading">
            <div class="parent-zone-heading-icon" aria-hidden="true">
                @(pendingTotal == 0 ? "✓" : "🔔")
            </div>
            <div>
                <span>@L["Today"]</span>
                <h2 id="parent-attention-title">@L["NeedsYourAttention"]</h2>
                <p>@L["AttentionHint"]</p>
            </div>
            <strong class="parent-attention-count">@pendingTotal</strong>
        </div>

        @if (pendingTotal == 0)
        {
            <div class="parent-all-clear">
                <span aria-hidden="true">🌿</span>
                <div>
                    <strong>@L["AllCaughtUp"]</strong>
                    <p>@L["AllCaughtUpHint"]</p>
                </div>
            </div>
        }
        else
        {
            <div class="parent-review-grid">
                @if (Model.PendingCare.Count > 0)
                {
                    <section class="parent-review-group" aria-labelledby="care-review-title">
                        <header>
                            <span aria-hidden="true">🐾</span>
                            <div>
                                <h3 id="care-review-title">@L["PendingCare"]</h3>
                                <p>@L["CareWaitingHint"]</p>
                            </div>
                            <strong>@Model.PendingCare.Count</strong>
                        </header>
                        <div class="approval-list">
                            @foreach (var item in Model.PendingCare)
                            {
                                <article class="approval-row parent-approval-card">
                                    <div>
                                        <strong>@item.ChildName — @item.TaskName</strong>
                                        <small>@item.PetName · @item.CompletedAt.ToLocalTime().ToString("g") · +@item.Points ★</small>
                                        @if (item.PhotoPaths.Count > 0)
                                        {
                                            <div class="care-photo-strip" aria-label="@L["TaskPhotos"]">
                                                @foreach (var photoPath in item.PhotoPaths)
                                                {
                                                    <button type="button" data-photo-viewer-src="@photoPath"
                                                            data-photo-viewer-alt="@L["TaskPhotoAlt", item.TaskName]">
                                                        <img src="@photoPath" alt="@L["TaskPhotoAlt", item.TaskName]" />
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="approval-actions">
                                        <form asp-action="ReviewCareLog" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="decision" value="@CareLogStatus.Approved" />
                                            <button type="submit" class="approve-button">
                                                <span aria-hidden="true">✓</span>
                                                @L["Approve"] · +@item.Points ★
                                            </button>
                                        </form>
                                        <form asp-action="ReviewCareLog" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="decision" value="@CareLogStatus.Rejected" />
                                            <button type="submit" class="reject-button">× @L["Reject"]</button>
                                        </form>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
                @if (Model.PendingRewards.Count > 0)
                {
                    <section class="parent-review-group" aria-labelledby="reward-review-title">
                        <header>
                            <span aria-hidden="true">🎁</span>
                            <div>
                                <h3 id="reward-review-title">@L["PendingRewardRequests"]</h3>
                                <p>@L["RewardWaitingHint"]</p>
                            </div>
                            <strong>@Model.PendingRewards.Count</strong>
                        </header>
                        <div class="approval-list">
                            @foreach (var item in Model.PendingRewards)
                            {
                                <article class="approval-row reward-approval-row parent-approval-card">
                                    @if (item.ImagePath is not null)
                                    {
                                        <img src="@item.ImagePath" alt="@L["RewardImageAlt", item.RewardName]" />
                                    }
                                    else
                                    {
                                        <div class="reward-image-placeholder" aria-hidden="true">🎁</div>
                                    }
                                    <div>
                                        <strong>@item.ChildName — @item.RewardName</strong>
                                        <small>@item.RequestedAt.ToLocalTime().ToString("g") · −@item.PointsCost ★</small>
                                    </div>
                                    <div class="approval-actions">
                                        <form asp-action="ReviewRewardRequest" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="decision" value="@RewardRedemptionStatus.Approved" />
                                            <button type="submit" class="approve-button">
                                                <span aria-hidden="true">✓</span>
                                                @L["Approve"] · −@item.PointsCost ★
                                            </button>
                                        </form>
                                        <form asp-action="ReviewRewardRequest" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="decision" value="@RewardRedemptionStatus.Rejected" />
                                            <button type="submit" class="reject-button">× @L["Reject"]</button>
                                        </form>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        }
    </section>

    <section class="parent-action-zone" aria-labelledby="parent-actions-title">
        <div class="parent-zone-heading">
            <div>
                <span>@L["StartHere"]</span>
                <h2 id="parent-actions-title">@L["WhatWouldYouLikeToDo"]</h2>
                <p>@L["QuickActionHint"]</p>
            </div>
        </div>
        <div class="parent-action-grid">
            <button type="button" class="parent-action-card action-family"
                    data-bs-toggle="modal" data-bs-target="#memberModal">
                <span class="parent-action-icon" aria-hidden="true">👨‍👩‍👧</span>
                <span>
                    <strong>@L["AddFamilyMember"]</strong>
                    <small>@L["ActionAddMemberHint"]</small>
                </span>
                <span class="parent-action-arrow" aria-hidden="true">＋</span>
            </button>
            <button type="button" class="parent-action-card action-pet"
                    data-bs-toggle="modal" data-bs-target="#petModal">
                <span class="parent-action-icon" aria-hidden="true">🐹</span>
                <span>
                    <strong>@L["AddPet"]</strong>
                    <small>@L["ActionAddPetHint"]</small>
                </span>
                <span class="parent-action-arrow" aria-hidden="true">＋</span>
            </button>
            <button type="button" class="parent-action-card action-task"
                    data-bs-toggle="modal" data-bs-target="#taskModal">
                <span class="parent-action-icon" aria-hidden="true">✓</span>
                <span>
                    <strong>@L["AddCareTask"]</strong>
                    <small>@L["ActionAddTaskHint"]</small>
                </span>
                <span class="parent-action-arrow" aria-hidden="true">＋</span>
            </button>
            <button type="button" class="parent-action-card action-reward"
                    data-bs-toggle="modal" data-bs-target="#rewardModal">
                <span class="parent-action-icon" aria-hidden="true">🎁</span>
                <span>
                    <strong>@L["AddReward"]</strong>
                    <small>@L["ActionAddRewardHint"]</small>
                </span>
                <span class="parent-action-arrow" aria-hidden="true">＋</span>
            </button>
        </div>
    </section>

    <section class="parent-overview @(Model.RewardChildren.Count > 0 ? "parent-points-overview" : "")"
             aria-labelledby="parent-overview-title">
        <div class="parent-zone-heading">
            <div>
                <span>@L["FamilyOverview"]</span>
                <h2 id="parent-overview-title">
                    @(Model.RewardChildren.Count > 0 ? L["FamilyPointsAtAGlance"] : L["FamilyAtAGlance"])
                </h2>
                @if (Model.RewardChildren.Count > 0)
                {
                    <p>@L["FamilyPointsHint"]</p>
                }
            </div>
        </div>
        @if (Model.RewardChildren.Count > 0)
        {
            <div class="parent-child-points-strip">
                @foreach (var child in Model.RewardChildren)
                {
                    <article class="parent-child-points-card">
                        <span class="parent-child-avatar" aria-hidden="true">
                            @(string.IsNullOrWhiteSpace(child.DisplayName) ? "?" : child.DisplayName[..1].ToUpperInvariant())
                        </span>
                        <div class="parent-child-points-copy">
                            <strong>@child.DisplayName</strong>
                            <a asp-action="FamilyMember" asp-route-id="@child.Id">
                                <span aria-hidden="true">◷</span> @L["History"]
                            </a>
                        </div>
                        <div class="parent-child-points-balance"
                             aria-label="@L["PointsCount", child.CurrentPoints]">
                            <span aria-hidden="true">★</span>
                            <strong>@child.CurrentPoints</strong>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="parent-overview-grid">
                <article><span aria-hidden="true">👨‍👩‍👧</span><div><strong>@Model.Members.Count</strong><small>@L["PeopleInFamily"]</small></div></article>
                <article><span aria-hidden="true">🐾</span><div><strong>@Model.Pets.Count</strong><small>@L["PetsAtHome"]</small></div></article>
                <article><span aria-hidden="true">✓</span><div><strong>@Model.CareTasks.Count</strong><small>@L["ActiveCareTasks"]</small></div></article>
                <article><span aria-hidden="true">🎁</span><div><strong>@Model.Rewards.Count</strong><small>@L["AvailableRewards"]</small></div></article>
            </div>
        }
    </section>

    <section class="parent-management-zone parent-daily-zone" aria-labelledby="parent-daily-title">
        <div class="parent-zone-heading">
            <div class="parent-zone-heading-icon" aria-hidden="true">☀</div>
            <div>
                <span>@L["Routine"]</span>
                <h2 id="parent-daily-title">@L["DailyManagement"]</h2>
                <p>@L["DailyManagementHint"]</p>
            </div>
        </div>

        <div class="parent-daily-stack">
            <section class="dashboard-panel dashboard-panel-wide parent-primary-panel"
                     aria-labelledby="care-settings-title">
                <div class="panel-heading">
                    <div>
                        <p><span aria-hidden="true">🐾</span> @L["CareTasks"]</p>
                        <h3 id="care-settings-title">@L["CareTaskSettings"]</h3>
                        <small>@L["CareTaskSettingsHint"]</small>
                    </div>
                    <button type="button" class="panel-link parent-section-add"
                            data-bs-toggle="modal" data-bs-target="#taskModal">
                        <span aria-hidden="true">＋</span> @L["AddTask"]
                    </button>
                </div>
                @if (Model.CareTasks.Count == 0)
                {
                    <p class="empty-message">@L["NoCareTasksYet"]</p>
                }
                else
                {
                    <div class="task-admin-grid">
                        @foreach (var task in Model.CareTasks)
                        {
                            <article class="task-admin-card">
                                <img class="task-admin-image" src="@task.ImagePath"
                                     alt="@L["TaskImageAlt", task.CategoryName]" />
                                <div class="task-admin-copy">
                                    <strong>@task.CategoryName</strong>
                                    <small>@task.PetName · @task.AssignedMemberName · @L[$"Frequency_{task.Frequency}"]</small>
                                </div>
                                <span class="point-pill">+@task.PointValue ★</span>
                                <div class="row-actions">
                                    @if (task.CanCurrentUserComplete)
                                    {
                                        <form asp-action="CompleteTaskAsParent" method="post" enctype="multipart/form-data">
                                            <input type="hidden" name="careTaskId" value="@task.Id" />
                                            <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple aria-label="@L["ChooseTaskPhotos"]" />
                                            <button type="submit" class="icon-action complete-action">
                                                <span aria-hidden="true">✓</span> @L["CompleteTask"]
                                            </button>
                                        </form>
                                    }
                                    <button type="button" class="icon-action"
                                            data-bs-toggle="modal" data-bs-target="#edit-task-@task.Id">
                                        <span aria-hidden="true">✎</span> @L["Edit"]
                                    </button>
                                    <form asp-action="DeleteCareTask" method="post"
                                          data-confirm="@L["ConfirmDeleteTask", task.CategoryName]">
                                        <input type="hidden" name="id" value="@task.Id" />
                                        <button type="submit" class="icon-action danger-action">
                                            <span aria-hidden="true">×</span> @L["Delete"]
                                        </button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="dashboard-panel dashboard-panel-wide parent-primary-panel"
                     aria-labelledby="reward-catalog-title">
                <div class="panel-heading">
                    <div>
                        <p><span aria-hidden="true">🎁</span> @L["Rewards"]</p>
                        <h3 id="reward-catalog-title">@L["RewardCatalog"]</h3>
                        <small>@L["RewardCatalogHint"]</small>
                    </div>
                    <button type="button" class="panel-link parent-section-add"
                            data-bs-toggle="modal" data-bs-target="#rewardModal">
                        <span aria-hidden="true">＋</span> @L["AddReward"]
                    </button>
                </div>
                @if (Model.Rewards.Count == 0)
                {
                    <p class="empty-message">@L["NoRewardsYet"]</p>
                }
                else
                {
                    <div class="reward-admin-grid">
                        @foreach (var reward in Model.Rewards)
                        {
                            <article class="reward-admin-card">
                                @if (reward.ImagePath is not null)
                                {
                                    <img src="@reward.ImagePath" alt="@L["RewardImageAlt", reward.Name]" />
                                }
                                else
                                {
                                    <div class="reward-image-placeholder" aria-hidden="true">🎁</div>
                                }
                                <div>
                                    <strong>@reward.Name</strong>
                                    <small>
                                        @L["VisibleTo"]:
                                        @(reward.VisibleToChildren.Count == 0
                                            ? L["Nobody"]
                                            : string.Join(", ", reward.VisibleToChildren))
                                    </small>
                                </div>
                                <span class="point-pill">−@reward.PointCost ★</span>
                            </article>
                        }
                    </div>
                    @if (Model.RewardChildren.Count > 0)
                    {
                        <section class="direct-reward-card" aria-labelledby="direct-reward-title">
                            <header>
                                <span class="direct-reward-icon" aria-hidden="true">🎁</span>
                                <div>
                                    <p>@L["Rewards"]</p>
                                    <h4 id="direct-reward-title">@L["LogRewardPurchase"]</h4>
                                    <small>@L["DirectPurchaseHint"]</small>
                                </div>
                            </header>
                            <form class="direct-reward-form direct-reward-flow"
                                  asp-action="PurchaseRewardForChild" method="post"
                                  data-direct-reward-form>
                                <div class="direct-reward-step">
                                    <label for="direct-reward-id">
                                        <span class="direct-reward-step-number" aria-hidden="true">1</span>
                                        <strong>@L["ChooseReward"]</strong>
                                    </label>
                                    <select asp-for="DirectRewardPurchase.RewardId"
                                            id="direct-reward-id"
                                            data-direct-reward-reward>
                                        <option value="">@L["ChooseReward"]</option>
                                        @foreach (var reward in Model.Rewards)
                                        {
                                            <option value="@reward.Id" data-points-cost="@reward.PointCost">
                                                @reward.Name · @L["PointsCount", reward.PointCost]
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="direct-reward-step">
                                    <label for="direct-reward-child-id">
                                        <span class="direct-reward-step-number" aria-hidden="true">2</span>
                                        <strong>@L["ChooseChild"]</strong>
                                    </label>
                                    <select asp-for="DirectRewardPurchase.HouseholdMemberId"
                                            id="direct-reward-child-id"
                                            data-direct-reward-child>
                                        <option value="">@L["ChooseChild"]</option>
                                        @foreach (var child in Model.RewardChildren)
                                        {
                                            <option value="@child.Id" data-current-points="@child.CurrentPoints">
                                                @child.DisplayName · @L["PointsCount", child.CurrentPoints]
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="direct-reward-summary"
                                     data-direct-reward-summary aria-live="polite">
                                    <div>
                                        <small>@L["RewardPointCost"]</small>
                                        <strong><span data-direct-reward-cost>—</span> ★</strong>
                                    </div>
                                    <div>
                                        <small>@L["CurrentPoints"]</small>
                                        <strong><span data-direct-reward-balance>—</span> ★</strong>
                                    </div>
                                    <div>
                                        <small>@L["StarsAfterReward"]</small>
                                        <strong><span data-direct-reward-remaining>—</span> ★</strong>
                                    </div>
                                </div>
                                <p class="direct-reward-warning"
                                   data-direct-reward-warning hidden>
                                    @L["NotEnoughPointsForPurchase"]
                                </p>
                                <div class="direct-reward-step direct-reward-confirm">
                                    <span class="direct-reward-step-number" aria-hidden="true">3</span>
                                    <div>
                                        <strong>@L["PurchaseReward"]</strong>
                                        <button type="submit"
                                                class="dashboard-button dashboard-button-primary"
                                                data-direct-reward-submit>
                                            <span aria-hidden="true">✓</span> @L["PurchaseReward"]
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </section>
                    }
                }
            </section>
        </div>
    </section>

    <section class="parent-management-zone parent-secondary-zone"
             aria-labelledby="parent-family-setup-title">
        <div class="parent-zone-heading">
            <div class="parent-zone-heading-icon" aria-hidden="true">⚙</div>
            <div>
                <span>@L["FamilyOverview"]</span>
                <h2 id="parent-family-setup-title">@L["FamilySetup"]</h2>
                <p>@L["FamilySetupHint"]</p>
            </div>
        </div>

        <div class="dashboard-grid parent-secondary-grid">
            <section class="dashboard-panel" aria-labelledby="care-team-title">
                <div class="panel-heading">
                    <div>
                        <p><span aria-hidden="true">👨‍👩‍👧</span> @L["Family"]</p>
                        <h3 id="care-team-title">@L["YourCareTeam"]</h3>
                        <small>@L["YourCareTeamHint"]</small>
                    </div>
                    <button type="button" class="panel-link parent-section-add"
                            data-bs-toggle="modal" data-bs-target="#memberModal">
                        <span aria-hidden="true">＋</span> @L["AddFamilyMember"]
                    </button>
                </div>
                @if (Model.Members.Count == 0)
                {
                    <p class="empty-message">@L["NoFamilyMembers"]</p>
                }
                else
                {
                    <div class="member-list">
                        @foreach (var member in Model.Members)
                        {
                            <article class="member-row">
                                @if (member.PhotoPath is not null)
                                {
                                    <img class="member-avatar member-photo" src="@member.PhotoPath"
                                         alt="@L["MemberPhotoAlt", member.DisplayName]" />
                                }
                                else
                                {
                                    <span class="member-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(member.DisplayName) ? "?" : member.DisplayName[..1].ToUpperInvariant())</span>
                                }
                                <div>
                                    <a class="member-history-link" asp-action="FamilyMember" asp-route-id="@member.Id">
                                        @member.DisplayName
                                    </a>
                                    <small>@member.Email</small>
                                </div>
                                <span class="role-badge">@L[$"Role_{member.Role}"]</span>
                                <div class="row-actions">
                                    <a class="icon-action" asp-action="FamilyMember" asp-route-id="@member.Id">
                                        <span aria-hidden="true">◷</span> @L["History"]
                                    </a>
                                    <button type="button" class="icon-action"
                                            data-bs-toggle="modal" data-bs-target="#edit-member-@member.Id">
                                        <span aria-hidden="true">✎</span> @L["Edit"]
                                    </button>
                                    @if (!member.IsCurrentUser)
                                    {
                                        <form asp-action="DeleteMember" method="post"
                                              data-confirm="@L["ConfirmDeleteMember", member.DisplayName]">
                                            <input type="hidden" name="id" value="@member.Id" />
                                            <button type="submit" class="icon-action danger-action">
                                                <span aria-hidden="true">×</span> @L["Delete"]
                                            </button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="dashboard-panel" aria-labelledby="family-pets-title">
                <div class="panel-heading">
                    <div>
                        <p><span aria-hidden="true">🐹</span> @L["Pets"]</p>
                        <h3 id="family-pets-title">@L["FamilyPets"]</h3>
                        <small>@L["FamilyPetsHint"]</small>
                    </div>
                    <button type="button" class="panel-link parent-section-add"
                            data-bs-toggle="modal" data-bs-target="#petModal">
                        <span aria-hidden="true">＋</span> @L["AddPet"]
                    </button>
                </div>
                @if (Model.Pets.Count == 0)
                {
                    <div class="empty-state">
                        <span aria-hidden="true">♡</span>
                        <p>@L["NoPetsYet"]</p>
                    </div>
                }
                else
                {
                    <div class="pet-list">
                        @foreach (var pet in Model.Pets)
                        {
                            <article class="pet-row">
                                @if (pet.PhotoPath is not null)
                                {
                                    <img class="pet-avatar pet-photo" src="@pet.PhotoPath"
                                         alt="@L["PetPhotoAlt", pet.Name]" />
                                }
                                else
                                {
                                    <span class="pet-avatar" aria-hidden="true">●</span>
                                }
                                <div><strong>@pet.Name</strong><small>@pet.Species</small></div>
                                <div class="row-actions">
                                    <button type="button" class="icon-action"
                                            data-bs-toggle="modal" data-bs-target="#edit-pet-@pet.Id">
                                        <span aria-hidden="true">✎</span> @L["Edit"]
                                    </button>
                                    <form asp-action="DeletePet" method="post"
                                          data-confirm="@L["ConfirmDeletePet", pet.Name]">
                                        <input type="hidden" name="id" value="@pet.Id" />
                                        <button type="submit" class="icon-action danger-action">
                                            <span aria-hidden="true">×</span> @L["Delete"]
                                        </button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    </section>

</div>

<div class="modal fade" id="memberModal" tabindex="-1" aria-labelledby="memberModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content account-modal dashboard-modal">

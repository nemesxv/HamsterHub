<div class="modal fade" id="taskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content account-modal dashboard-modal">
            <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="@L["Close"]">×</button>
            <div class="modal-mark" aria-hidden="true">✓</div>
            <h2 id="taskModalLabel">@L["AddCareTask"]</h2>
            <p>@L["TaskFormIntro"]</p>
            <form asp-action="AddCareTask" method="post" enctype="multipart/form-data">
                <label asp-for="AddCareTask.Name"></label>
                <input asp-for="AddCareTask.Name" required maxlength="100" placeholder="@L["TaskNamePlaceholder"]" />
                <label asp-for="AddCareTask.PetId"></label>
                <select asp-for="AddCareTask.PetId">
                    <option value="">@L["NoPet"]</option>
                    @foreach (var pet in Model.Pets)
                    {
                        <option value="@pet.Id">@pet.Name</option>
                    }
                </select>
                <label asp-for="AddCareTask.AssignedMemberId"></label>
                <select asp-for="AddCareTask.AssignedMemberId">
                    <option value="">@L["ChooseMember"]</option>
                    @foreach (var member in Model.Members)
                    {
                        <option value="@member.Id">@member.DisplayName · @L[$"Role_{member.Role}"]</option>
                    }
                </select>
                <label asp-for="AddCareTask.CategoryId"></label>
                <select asp-for="AddCareTask.CategoryId">
                    <option value="">@L["NoCategory"]</option>
                    @foreach (var category in Model.CareCategories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <label asp-for="AddCareTask.NewCategoryName"></label>
                <input asp-for="AddCareTask.NewCategoryName" placeholder="@L["NewCategoryPlaceholder"]" />
                <small class="field-hint">@L["NewCategoryHint"]</small>
                <label asp-for="AddCareTask.Image"></label>
                <input asp-for="AddCareTask.Image" type="file"
                       accept="image/jpeg,image/png,image/webp" />
                <small class="field-hint">@L["TaskImageHint"]</small>
                <div class="form-columns">
                    <div>
                        <label asp-for="AddCareTask.Frequency"></label>
                        <select asp-for="AddCareTask.Frequency">
                            @foreach (var frequency in Enum.GetValues<CareTaskFrequency>())
                            {
                                <option value="@((int)frequency)">@L[$"Frequency_{frequency}"]</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="AddCareTask.PointValue"></label>
                        <input asp-for="AddCareTask.PointValue" />
                    </div>
                </div>
                <partial name="_TaskReminder" model='new TaskReminderFormModel("AddCareTask", "new-task", null)' />
                <button type="submit" class="modal-submit">@L["SaveCareTask"]</button>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="rewardModal" tabindex="-1"
     aria-labelledby="rewardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content account-modal dashboard-modal">
            <button type="button" class="modal-close" data-bs-dismiss="modal"
                    aria-label="@L["Close"]">×</button>
            <div class="modal-mark" aria-hidden="true">🎁</div>
            <h2 id="rewardModalLabel">@L["AddReward"]</h2>
            <p>@L["RewardFormIntro"]</p>
            <form asp-action="AddReward" method="post" enctype="multipart/form-data">
                <label asp-for="AddReward.Name"></label>
                <input asp-for="AddReward.Name" />
                <label asp-for="AddReward.PointCost"></label>
                <input asp-for="AddReward.PointCost" type="number" min="1" max="100000" />
                <label asp-for="AddReward.Image"></label>
                <input asp-for="AddReward.Image" type="file"
                       accept="image/jpeg,image/png,image/webp" />
                <small class="field-hint">@L["RewardImageHint"]</small>
                <fieldset class="reward-audience">
                    <legend>@L["RewardVisibleTo"]</legend>
                    @foreach (var child in Model.RewardChildren)
                    {
                        <label>
                            <input type="checkbox" name="AddReward.VisibleToMemberIds"
                                   value="@child.Id" />
                            <span>@child.DisplayName</span>
                        </label>
                    }
                </fieldset>
                @if (Model.RewardChildren.Count == 0)
                {
                    <small class="field-hint">@L["AddChildBeforeReward"]</small>
                }
                <button type="submit" class="modal-submit"
                        disabled="@(Model.RewardChildren.Count == 0)">@L["SaveReward"]</button>
            </form>
        </div>
    </div>
</div>

@foreach (var member in Model.Members)
{
    <div class="modal fade" id="edit-member-@member.Id" tabindex="-1"
         aria-labelledby="edit-member-label-@member.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content account-modal dashboard-modal">
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="@L["Close"]">×</button>
                <h2 id="edit-member-label-@member.Id">@L["EditFamilyMember"]</h2>
                <form asp-action="UpdateMember" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="UpdateMember.Id" value="@member.Id" />
                    <label for="member-name-@member.Id">@L["DisplayName"]</label>
                    <input id="member-name-@member.Id" name="UpdateMember.DisplayName" value="@member.DisplayName" required maxlength="100" />
                    <label for="member-role-@member.Id">@L["FamilyRole"]</label>
                    <select id="member-role-@member.Id" name="UpdateMember.Role"
                            disabled="@member.IsCurrentUser">
                        <option value="@((int)HouseholdMemberRole.Child)" selected="@(member.Role == HouseholdMemberRole.Child)">@L["Role_Child"]</option>
                        <option value="@((int)HouseholdMemberRole.Parent)" selected="@(member.Role == HouseholdMemberRole.Parent)">@L["Role_Parent"]</option>
                    </select>
                    @if (member.IsCurrentUser)
                    {
                        <input type="hidden" name="UpdateMember.Role" value="@((int)member.Role)" />
                    }
                    <label for="member-photo-@member.Id">@L["ReplaceMemberPhoto"]</label>
                    <input id="member-photo-@member.Id" name="UpdateMember.Photo" type="file"
                           accept="image/jpeg,image/png,image/webp" />
                    <small class="field-hint">@L["MemberPhotoHint"]</small>
                    @if (member.PhotoPath is not null)
                    {
                        <label class="remember-row">
                            <input type="checkbox" name="UpdateMember.RemovePhoto" value="true" />
                            <span>@L["RemoveMemberPhoto"]</span>
                        </label>
                    }
                    <button type="submit" class="modal-submit">@L["SaveChanges"]</button>
                </form>
            </div>
        </div>
    </div>
}


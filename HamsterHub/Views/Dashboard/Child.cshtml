@model KidDashboardViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["KidDashboardTitle"];
    ViewData["BodyClass"] = "kid-world";
}

<div class="kid-canvas">
    <div class="kid-doodle kid-doodle-star" aria-hidden="true">☆</div>
    <div class="kid-doodle kid-doodle-heart" aria-hidden="true">♡</div>
    <div class="kid-doodle kid-doodle-flower" aria-hidden="true">✿</div>

    <section class="kid-hello">
        <div class="kid-hello-copy">
            <span class="kid-sparkles" aria-hidden="true">✦ · ✧</span>
            <h1>@L["KidWelcome", Model.ChildName]</h1>
            <p>@(string.IsNullOrWhiteSpace(Model.HouseholdName) ? L["WaitingForFamily"] : L["KidLetsCare"])</p>
        </div>
        <div class="kid-star-jar" aria-label="@L["PointsLabel", Model.CurrentPoints]">
            <span aria-hidden="true">★</span>
            <strong>@Model.CurrentPoints</strong>
        </div>
    </section>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="kid-celebration dashboard-toast" role="status"
             data-dashboard-notice>
            <span aria-hidden="true">🎉</span>
            <strong>@statusMessage</strong>
            <button type="button" class="dashboard-toast-close"
                    data-dashboard-notice-close aria-label="@L["Close"]">×</button>
        </div>
    }

    <section class="kid-picture-counts" aria-label="@L["KidOverview"]">
        <button type="button" class="kid-count-card kid-pets-button"
                data-bs-toggle="modal" data-bs-target="#kidPetsModal"
                disabled="@(Model.Pets.Count == 0)"
                aria-label="@L["OpenPets", Model.Pets.Count]">
            <span class="kid-count-picture" aria-hidden="true">🐹</span>
            <strong>@Model.Pets.Count</strong>
            <small>@L["KidPetsShort"]</small>
        </button>
        <article>
            <span class="kid-count-picture" aria-hidden="true">🎨</span>
            <strong>@Model.CareTasks.Count</strong>
            <small>@L["KidTasksShort"]</small>
        </article>
        <article>
            <span class="kid-count-picture" aria-hidden="true">⏳</span>
            <strong>@Model.PendingCount</strong>
            <small>@L["KidWaitingShort"]</small>
        </article>
    </section>

    <section class="kid-play-section">
        <header class="kid-section-title">
            <span aria-hidden="true">🌈</span>
            <h2>@L["KidChooseTask"]</h2>
        </header>

        @if (Model.Pets.Count == 0 || Model.CareTasks.Count == 0)
        {
            <div class="kid-picture-empty">
                <span aria-hidden="true">🐹</span>
                <span aria-hidden="true">＋</span>
                <span aria-hidden="true">💛</span>
                <p>@L["KidAskGrownup"]</p>
            </div>
        }
        else
        {
            <div class="kid-big-task-grid">
                @foreach (var task in Model.CareTasks)
                {
                    var rhythmIcon = task.Frequency switch
                    {
                        CareTaskFrequency.Daily => "☀",
                        CareTaskFrequency.Weekly => "📅",
                        _ => "✨"
                    };
                    <article class="kid-big-task-card">
                        <button type="button" class="kid-task-art"
                                data-bs-toggle="modal" data-bs-target="#complete-task-@task.Id"
                                aria-label="@L["OpenTask", task.CategoryName, task.PetName]">
                            <img src="@task.ImagePath" alt="@L["TaskImageAlt", task.CategoryName]" />
                            @if (task.PetPhotoPath is not null)
                            {
                                <img class="kid-task-pet-badge" src="@task.PetPhotoPath"
                                     alt="@L["PetPhotoAlt", task.PetName]" />
                            }
                            <span class="kid-rhythm-sticker" title="@L[$"Frequency_{task.Frequency}"]"
                                  aria-label="@L[$"Frequency_{task.Frequency}"]">@rhythmIcon</span>
                        </button>
                        <div class="kid-task-name">
                            <small>@task.PetName</small>
                            <h3>@task.CategoryName</h3>
                        </div>
                        <div class="kid-task-reward" aria-label="@L["TaskPointsLabel", task.PointValue]">
                            <span aria-hidden="true">★</span>
                            <strong>+@task.PointValue</strong>
                        </div>
                        <button type="button" class="kid-complete-button"
                                data-bs-toggle="modal" data-bs-target="#complete-task-@task.Id">
                            <span aria-hidden="true">✓</span>
                            @L["KidDone"]
                        </button>
                    </article>
                }
            </div>
        }
    </section>

    <section class="kid-reward-section">
        <header class="kid-section-title">
            <span aria-hidden="true">🎁</span>
            <h2>@L["KidRewards"]</h2>
        </header>
        @if (Model.Rewards.Count == 0)
        {
            <div class="kid-picture-empty">
                <span aria-hidden="true">✨</span>
                <p>@L["KidNoRewards"]</p>
            </div>
        }
        else
        {
            <div class="kid-reward-grid">
                @foreach (var reward in Model.Rewards)
                {
                    <article class="kid-reward-card">
                        @if (reward.ImagePath is not null)
                        {
                            <img src="@reward.ImagePath" alt="@L["RewardImageAlt", reward.Name]" />
                        }
                        else
                        {
                            <div class="kid-reward-picture-placeholder" aria-hidden="true">🎁</div>
                        }
                        <div class="kid-reward-card-copy">
                            <h3>@reward.Name</h3>
                            <strong>−@reward.PointCost ★</strong>
                        </div>
                        <form asp-action="RequestReward" method="post">
                            <input type="hidden" name="rewardId" value="@reward.Id" />
                            <button type="submit"
                                    disabled="@(!reward.CanAfford || reward.HasPendingRequest)">
                                @(reward.HasPendingRequest
                                    ? L["RewardWaiting"]
                                    : reward.CanAfford
                                        ? L["RequestReward"]
                                        : L["NeedMorePoints"])
                            </button>
                        </form>
                    </article>
                }
            </div>
        }
        @if (Model.RewardRedemptions.Count > 0)
        {
            <div class="kid-reward-history">
                <h3>@L["MyRewardRequests"]</h3>
                <div class="kid-reward-history-grid">
                    @foreach (var request in Model.RewardRedemptions)
                    {
                        var statusIcon = request.Status switch
                        {
                            RewardRedemptionStatus.Approved => "✓",
                            RewardRedemptionStatus.Rejected => "×",
                            _ => "⏳"
                        };
                        <article class="kid-reward-history-card status-@request.Status.ToString().ToLowerInvariant()">
                            <div class="kid-reward-history-art">
                                @if (request.ImagePath is not null)
                                {
                                    <img src="@request.ImagePath"
                                         alt="@L["RewardImageAlt", request.RewardName]" />
                                }
                                else
                                {
                                    <div class="kid-reward-history-picture" aria-hidden="true">🎁</div>
                                }
                                <span class="kid-reward-status-icon"
                                      aria-label="@L[$"RewardStatus_{request.Status}"]">@statusIcon</span>
                            </div>
                            <div class="kid-reward-history-copy">
                                <span>@L[$"RewardStatus_{request.Status}"]</span>
                                <strong>@request.RewardName</strong>
                                <small>@request.RequestedAt.ToLocalTime().ToString("dd.MM")</small>
                                @if (request.PointsBalanceAfterApproval is not null)
                                {
                                    <small>@L["PointsLeftAfterReward", request.PointsBalanceAfterApproval]</small>
                                }
                            </div>
                            <div class="kid-spend-star"
                                 aria-label="@(request.Status == RewardRedemptionStatus.Approved
                                     ? L["PointsDeductedCount", request.PointsCost]
                                     : L["RewardCostCount", request.PointsCost])">
                                <span aria-hidden="true">★</span>
                                <strong>@(request.Status == RewardRedemptionStatus.Approved ? "−" : "")@request.PointsCost</strong>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
    </section>

    <section class="kid-memory-section">
        <header class="kid-section-title">
            <span aria-hidden="true">🖍️</span>
            <h2>@L["KidMyPictures"]</h2>
        </header>
        @if (Model.RecentCare.Count == 0)
        {
            <div class="kid-picture-empty kid-memory-empty">
                <span aria-hidden="true">🖼️</span>
                <p>@L["KidNoMemories"]</p>
            </div>
        }
        else
        {
            <div class="kid-polaroid-row">
                @foreach (var item in Model.RecentCare)
                {
                    var statusIcon = item.Status switch
                    {
                        CareLogStatus.Approved => "✓",
                        CareLogStatus.Rejected => "×",
                        _ => "⏳"
                    };
                    <button type="button"
                            class="kid-polaroid status-@item.Status.ToString().ToLowerInvariant()"
                            data-photo-gallery
                            aria-label="@L["OpenTaskPhotos", item.TaskName]">
                        <div class="kid-polaroid-picture">
                            <img src="@item.ImagePath" alt="@L["TaskImageAlt", item.TaskName]" />
                            <span class="kid-polaroid-status" aria-label="@L[$"Status_{item.Status}"]">@statusIcon</span>
                            @if (item.PhotoPaths.Count > 1)
                            {
                                <span class="kid-photo-count" aria-label="@L["PhotoCount", item.PhotoPaths.Count]">
                                    📷 @item.PhotoPaths.Count
                                </span>
                            }
                        </div>
                        <strong>@item.TaskName</strong>
                        <small>@item.PetName · @item.CompletedAt.ToLocalTime().ToString("dd.MM")</small>
                        <span class="kid-polaroid-points">+@item.Points ★</span>
                        @if (item.PhotoPaths.Count > 0)
                        {
                            @foreach (var photoPath in item.PhotoPaths)
                            {
                                <span data-gallery-photo data-src="@photoPath"
                                      data-alt="@L["TaskPhotoAlt", item.TaskName]" hidden></span>
                            }
                        }
                        else
                        {
                            <span data-gallery-photo data-src="@item.ImagePath"
                                  data-alt="@L["TaskImageAlt", item.TaskName]" hidden></span>
                        }
                    </button>
                }
            </div>
        }
    </section>

    <section class="kid-family-section">
        <header class="kid-section-title">
            <span aria-hidden="true">👭</span>
            <h2>@L["KidFriends"]</h2>
        </header>
        @if (Model.FamilyMembers.Count == 0)
        {
            <div class="kid-picture-empty kid-family-empty">
                <span aria-hidden="true">💌</span>
                <p>@L["KidNoVisibleFamily"]</p>
            </div>
        }
        else
        {
            <div class="kid-friend-grid">
                @foreach (var member in Model.FamilyMembers)
                {
                    <a class="kid-friend-card" asp-action="ChildFamilyMember"
                       asp-route-id="@member.Id"
                       aria-label="@L["OpenMemberHistory", member.DisplayName]">
                        @if (member.PhotoPath is not null)
                        {
                            <img src="@member.PhotoPath"
                                 alt="@L["MemberPhotoAlt", member.DisplayName]" />
                        }
                        else
                        {
                            <span class="kid-friend-placeholder" aria-hidden="true">
                                @(member.Role == HouseholdMemberRole.Parent ? "🧑" : "🧒")
                            </span>
                        }
                        <span class="kid-friend-name">
                            <strong>@member.DisplayName</strong>
                            <small>@L[$"Role_{member.Role}"]</small>
                        </span>
                        <span class="kid-friend-points"
                              aria-label="@L["PointsLabel", member.CurrentPoints]">
                            <span aria-hidden="true">★</span>
                            <strong>@member.CurrentPoints</strong>
                        </span>
                    </a>
                }
            </div>
        }
    </section>
</div>

<div class="modal fade kid-pets-modal" id="kidPetsModal" tabindex="-1"
     aria-labelledby="kidPetsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <button type="button" class="modal-close" data-bs-dismiss="modal"
                    aria-label="@L["Close"]">×</button>
            <span class="kid-pets-modal-icon" aria-hidden="true">🐾</span>
            <h2 id="kidPetsModalTitle">@L["KidMyPets"]</h2>
            <div class="kid-pet-gallery">
                @foreach (var pet in Model.Pets)
                {
                    @if (pet.PhotoPath is not null)
                    {
                        <button type="button" class="kid-pet-gallery-card"
                                data-photo-viewer-src="@pet.PhotoPath"
                                data-photo-viewer-alt="@L["PetPhotoAlt", pet.Name]">
                            <img src="@pet.PhotoPath" alt="@L["PetPhotoAlt", pet.Name]" />
                            <strong>@pet.Name</strong>
                            <small>@pet.Species</small>
                        </button>
                    }
                    else
                    {
                        <article class="kid-pet-gallery-card">
                            <span class="kid-pet-gallery-placeholder" aria-hidden="true">🐹</span>
                            <strong>@pet.Name</strong>
                            <small>@pet.Species</small>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
</div>

@foreach (var task in Model.CareTasks)
{
    <div class="modal fade kid-complete-modal" id="complete-task-@task.Id" tabindex="-1"
         aria-labelledby="complete-task-title-@task.Id" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <button type="button" class="modal-close" data-bs-dismiss="modal"
                        aria-label="@L["Close"]">×</button>
                <img class="kid-complete-picture" src="@task.ImagePath"
                     alt="@L["TaskImageAlt", task.CategoryName]" />
                <h2 id="complete-task-title-@task.Id">@task.CategoryName</h2>
                <p>@task.PetName</p>
                <form asp-action="CompleteTask" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="careTaskId" value="@task.Id" />
                    <div class="kid-photo-choices">
                        <button type="button" data-camera-open>
                            <span aria-hidden="true">📷</span>
                            <strong>@L["TakeTaskPhoto"]</strong>
                        </button>
                        <label>
                            <span aria-hidden="true">🖼️</span>
                            <strong>@L["ChooseTaskPhotos"]</strong>
                            <input type="file" name="photos" data-gallery-input
                                   accept="image/jpeg,image/png,image/webp"
                                   multiple />
                        </label>
                    </div>
                    <input type="file" name="photos" data-camera-input
                           accept="image/jpeg,image/png,image/webp" capture="environment" hidden />
                    <div class="kid-camera-panel" data-camera-panel hidden>
                        <video data-camera-video autoplay playsinline muted
                               aria-label="@L["CameraPreview"]"></video>
                        <div>
                            <button type="button" data-camera-capture>📸 @L["CapturePhoto"]</button>
                            <button type="button" data-camera-cancel>@L["Cancel"]</button>
                        </div>
                        <canvas data-camera-canvas hidden></canvas>
                    </div>
                    <div class="kid-selected-photo-preview" data-photo-preview
                         aria-label="@L["SelectedPhotos"]"></div>
                    <small class="kid-photo-hint">@L["TaskPhotosOptional"]</small>
                    <button type="submit" class="kid-modal-done">
                        <span aria-hidden="true">★</span>
                        @L["SendForApproval"]
                    </button>
                </form>
            </div>
        </div>
    </div>
}

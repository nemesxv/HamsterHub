@page
@model HamsterHub.Areas.Identity.Pages.Account.Manage.IndexModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["ManageAccount"];
}

<div class="account-page-shell">
    <section class="account-page-card">
        <p class="dashboard-kicker">@L["AccountSettings"]</p>
        <h1>@L["ManageYourAccount"]</h1>
        <p>@L["AccountSettingsIntro"]</p>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="dashboard-notice" role="status">@Model.StatusMessage</div>
        }

        <form method="post" class="account-settings-form">
            <div asp-validation-summary="ModelOnly" class="validation-message"></div>
            <label asp-for="Input.DisplayName"></label>
            <input asp-for="Input.DisplayName" autocomplete="name" />
            <span asp-validation-for="Input.DisplayName" class="validation-message"></span>

            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="validation-message"></span>

            <button type="submit" class="modal-submit">@L["SaveChanges"]</button>
        </form>

        <div class="account-page-links">
            <a asp-page="./ChangePassword">@L["ChangePassword"]</a>
            <a asp-area="" asp-controller="Dashboard" asp-action="Parent">@L["BackToDashboard"]</a>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

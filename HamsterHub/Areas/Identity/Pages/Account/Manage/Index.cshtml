@page
@model HamsterHub.Areas.Identity.Pages.Account.Manage.IndexModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Profile"];
}

<header class="account-section-heading">
    <span class="account-section-icon" aria-hidden="true">☺</span>
    <div>
        <p class="dashboard-kicker">@L["Profile"]</p>
        <h2>@L["ProfileSettings"]</h2>
        <p>@L["ProfileSettingsIntro"]</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="account-status is-success" role="status">
        <span aria-hidden="true">✓</span>
        @Model.StatusMessage
    </div>
}

<form method="post" class="account-settings-form">
    <div asp-validation-summary="ModelOnly" class="validation-message"></div>
    <div class="account-field">
        <label asp-for="Input.DisplayName"></label>
        <input asp-for="Input.DisplayName" autocomplete="name" />
        <span asp-validation-for="Input.DisplayName" class="validation-message"></span>
    </div>

    <div class="account-field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="email" inputmode="email" />
        <span asp-validation-for="Input.Email" class="validation-message"></span>
        <small>@L["EmailSignInHint"]</small>
    </div>

    <div class="account-form-actions">
        <button type="submit" class="account-primary-button">@L["SaveChanges"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model HamsterHub.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["ChangePassword"];
}

<header class="account-section-heading">
    <span class="account-section-icon" aria-hidden="true">⌁</span>
    <div>
        <p class="dashboard-kicker">@L["PasswordAndAccess"]</p>
        <h2>@L["ChangePassword"]</h2>
        <p>@L["PasswordSettingsIntro"]</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="account-status is-success" role="status">
        <span aria-hidden="true">✓</span>
        @Model.StatusMessage
    </div>
}

<form method="post" class="account-settings-form">
    <div asp-validation-summary="ModelOnly" class="validation-message"></div>

    <div class="account-field">
        <label asp-for="Input.OldPassword"></label>
        <input asp-for="Input.OldPassword" autocomplete="current-password" />
        <span asp-validation-for="Input.OldPassword" class="validation-message"></span>
    </div>

    <div class="account-field">
        <label asp-for="Input.NewPassword"></label>
        <input asp-for="Input.NewPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="validation-message"></span>
        <small>@L["PasswordRequirements"]</small>
    </div>

    <div class="account-field">
        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="validation-message"></span>
    </div>

    <div class="account-form-actions">
        <button type="submit" class="account-primary-button">@L["UpdatePassword"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
